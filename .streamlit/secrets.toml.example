# Copy these top-level entries into Streamlit > App settings > Secrets.
# Locally, copy this file to .streamlit/secrets.toml (ignored by git).
GEMINI_API_KEY = "paste-your-gemini-api-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
# Optional, separately hosted cohort service:
# AE_API_URL = "https://your-cohort-api.example.com"
# Separate admin sign-in (required for corrections and IN imports):
# AE_ADMIN_USERNAME = "your-admin-name"
# Generate a salted hash with: python scripts/admin_password.py
# AE_ADMIN_PASSWORD_HASH = "scrypt$..."

# Existing private bootstrap alternative (keep values private):
# AE_ADMIN_NUMBER = "AE-your-existing-admin-number"
# AE_ADMIN_RECOVERY = "your-existing-64-hex-recovery-code"
