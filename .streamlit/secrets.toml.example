# Copy these top-level entries into Streamlit > App settings > Secrets.
# Locally, copy this file to .streamlit/secrets.toml (ignored by git).
GEMINI_API_KEY = "paste-your-gemini-api-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
